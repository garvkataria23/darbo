rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Accounts Collection: users can read & write their own account data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders Collection: authenticated users can create & read their own orders
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Products Collection: public read access for storefront catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Custom Outfit Designs: users can manage their own saved custom streetwear designs
    match /custom_designs/{designId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
